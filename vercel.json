{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container"
    },
    "hospital-frontend": {
      "root": "hospital-frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "patient-frontend": {
      "root": "patient-frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "hospital-frontend"
      }
    },
    {
      "source": "/hospital-login",
      "destination": {
        "service": "hospital-frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "patient-frontend"
      }
    }
  ]
}
