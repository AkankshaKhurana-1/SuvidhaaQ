{
  "name": "hospital-queue-system",
  "version": "1.0.0",
  "description": "SuvidhaaQ — Digital Hospital OPD Queue and Appointment Management System",
  "main": "dist/server.js",
  "scripts": {
    "clean:ports": "node -e 'const { execSync } = require(\"child_process\"); try { execSync(\"lsof -ti :3000 -ti :5001 | xargs kill -9 2>/dev/null\"); } catch (e) {}'",
    "predev": "npm run clean:ports",
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "ts-node-dev --project backend/tsconfig.json --respawn --transpile-only backend/src/server.ts",
    "dev:frontend": "cd patient-frontend && npm run dev",
    "build": "tsc --project backend/tsconfig.json",
    "build:backend": "tsc --project backend/tsconfig.json",
    "build:patient": "cd patient-frontend && npm run build",
    "build:hospital": "cd hospital-frontend && npm run build",
    "build:all": "npm run build:backend && npm run build:patient && npm run build:hospital",
    "start": "node backend/dist/server.js",
    "seed": "npx ts-node -r dotenv/config backend/src/prisma/seed.ts",
    "db:push": "prisma db push --schema=backend/src/prisma/schema.prisma",
    "test": "npx vitest run",
    "prisma:generate": "prisma generate --schema=backend/src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1"
  }
}
