{
  "name": "hospital-queue-backend",
  "version": "1.0.0",
  "description": "Hospital Queue Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --project backend/tsconfig.json --respawn --transpile-only backend/src/server.ts",
    "build": "tsc --project backend/tsconfig.json",
    "start": "node backend/dist/server.js",
    "prisma:generate": "prisma generate --schema=backend/src/prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema=backend/src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
