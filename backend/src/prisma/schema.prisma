generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
  ADMIN
}

enum AppointmentType {
  NEW
  FOLLOW_UP
  WALK_IN
}

enum AppointmentStatus {
  BOOKED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TokenStatus {
  PENDING
  ARRIVED
  DELAYED
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum QueueTier {
  EMERGENCY
  SENIOR
  NEW_CONSULTATION
  FOLLOW_UP
  WALK_IN
}

model Hospital {
  id             String         @id @default(uuid())
  name           String
  registrationNo String         @unique
  address        String
  phone          String
  email          String
  workingHours   String         @default("08:00 - 20:00")
  settings       Json?          // { capacitySplit: { new: 50, followUp: 20, walkIn: 30 } }
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users          User[]
  departments    Department[]
  doctors        Doctor[]
  patients       Patient[]
  appointments   Appointment[]
  queueTokens    QueueToken[]
  consultations  Consultation[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  billingInvoices BillingInvoice[]
  labReports     LabReport[]
  sequences      DoctorDailySequence[]
}

model User {
  id             String         @id @default(uuid())
  hospitalId     String?
  role           Role
  name           String
  email          String?        @unique
  phone          String?        @unique
  passwordHash   String
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  hospital       Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor         Doctor?
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  bookedPatients Patient[]      @relation("UserBookedPatients")

  @@index([hospitalId])
  @@index([role])
}

model Department {
  id            String    @id @default(uuid())
  hospitalId    String
  name          String
  location      String
  dailyCapacity Int       @default(50)
  createdAt     DateTime  @default(now())

  hospital      Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors       Doctor[]

  @@index([hospitalId])
}

model Doctor {
  id                  String         @id @default(uuid())
  userId              String         @unique
  hospitalId          String
  departmentId        String
  specialization      String
  consultationMinutes Int            @default(15)
  room                String
  available           Boolean        @default(true)
  sessionDelay        Int            @default(0) // actualDuration - plannedDuration accumulated in mins
  createdAt           DateTime       @default(now())

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital            Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department          Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  queueTokens         QueueToken[]
  consultations       Consultation[]
  sequences           DoctorDailySequence[]

  @@index([hospitalId])
  @@index([departmentId])
  @@index([available])
}

model Patient {
  id               String         @id @default(uuid())
  hospitalId       String
  bookedForUserId  String?
  name             String
  age              Int
  gender           String
  phone            String
  isSenior         Boolean        @default(false)
  uhid             String         @unique
  createdAt        DateTime       @default(now())

  hospital         Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bookedForUser    User?          @relation("UserBookedPatients", fields: [bookedForUserId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  queueTokens      QueueToken[]
  consultations    Consultation[]
  billingInvoices  BillingInvoice[]
  labReports       LabReport[]

  @@index([hospitalId])
  @@index([phone])
  @@index([uhid])
}

model DoctorDailySequence {
  id              String    @id @default(uuid())
  hospitalId      String
  doctorId        String
  date            String    // Format: YYYY-MM-DD
  currentSequence Int       @default(0)
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor          Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([hospitalId])
}

model Appointment {
  id           String            @id @default(uuid())
  hospitalId   String
  patientId    String
  doctorId     String
  scheduledAt  DateTime
  type         AppointmentType   @default(NEW)
  status       AppointmentStatus @default(BOOKED)
  createdAt    DateTime          @default(now())

  hospital     Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  queueToken   QueueToken?

  @@index([hospitalId])
  @@index([doctorId, scheduledAt])
  @@index([status])
}

model QueueToken {
  id                   String        @id @default(uuid())
  hospitalId           String
  patientId            String
  doctorId             String
  appointmentId        String?       @unique
  code                 String        // Format: {CATEGORY}-{SEQUENCE} e.g. NEW-001, FUP-004, WLK-012, EMG-001
  sequence             Int
  tier                 QueueTier
  score                Int           @default(0)
  status               TokenStatus   @default(PENDING)
  position             Int           @default(0)
  estimatedWaitMinutes Int           @default(0)
  arrivedAt            DateTime?
  calledAt             DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  lateCount            Int           @default(0)
  createdAt            DateTime      @default(now())

  hospital             Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor               Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment          Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultation         Consultation?

  @@index([hospitalId])
  @@index([doctorId, status])
  @@index([patientId])
  @@index([status])
  @@index([tier])
}

model Consultation {
  id              String          @id @default(uuid())
  hospitalId      String
  tokenId         String          @unique
  doctorId        String
  patientId       String
  notes           String?
  followUpDate    DateTime?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int             @default(0)
  createdAt       DateTime        @default(now())

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  token           QueueToken      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  doctor          Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  billingInvoice  BillingInvoice?
  labReports      LabReport[]

  @@index([hospitalId])
  @@index([doctorId])
  @@index([patientId])
}

model Notification {
  id         String    @id @default(uuid())
  hospitalId String?
  userId     String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([hospitalId])
}

model AuditLog {
  id          String   @id @default(uuid())
  hospitalId  String?
  actorId     String?
  actorEmail  String?
  role        String
  action      String
  entity      String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  token           String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model BillingInvoice {
  id             String        @id @default(uuid())
  hospitalId     String
  patientId      String
  consultationId String?       @unique
  amount         Decimal       @db.Decimal(10, 2)
  paymentStatus  String        @default("Pending") // Paid, Pending, Refunded
  createdAt      DateTime      @default(now())

  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([patientId])
}

model LabReport {
  id             String        @id @default(uuid())
  hospitalId     String
  patientId      String
  consultationId String?
  reportType     String
  reportName     String
  reportFileUrl  String
  status         String        @default("Ready") // Pending, Ready, Reviewed
  uploadedAt     DateTime      @default(now())

  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([patientId])
}
